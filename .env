# Public build-time configuration (safe to commit — VITE_* values are shipped to browsers).
# Never put secrets here. Server secrets belong in the hosting provider's environment settings.

# Canonical site origin, no trailing slash. Owner to confirm the production domain.
VITE_SITE_URL=https://kreatifylabs.com

# Enquiry endpoint (same-origin serverless function by default).
VITE_LEAD_ENDPOINT=/api/lead

# Optional privacy-safe collectors (leave empty to disable).
VITE_ANALYTICS_ENDPOINT=
VITE_VITALS_ENDPOINT=
